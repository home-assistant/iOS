/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Ative ${scene} no ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Ative a cena ${scene} no ${applicationName}";
"Activate a scene in ${applicationName}" = "Ative uma cena no ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Ligue ${entity} no ${applicationName}";
"Open ${entity} in ${applicationName}" = "Abra ${entity} no ${applicationName}";
"Turn something on in ${applicationName}" = "Ligue algo no ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Desligue ${entity} no ${applicationName}";
"Close ${entity} in ${applicationName}" = "Feche ${entity} no ${applicationName}";
"Turn something off in ${applicationName}" = "Desligue algo no ${applicationName}";
"Check an entity in ${applicationName}" = "Verifique uma entidade no ${applicationName}";
"Get an entity state from ${applicationName}" = "Obtenha o estado de uma entidade do ${applicationName}";
"Is ${entity} on in ${applicationName}" = "${entity} está ligado no ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Qual é o estado de ${entity} no ${applicationName}";
"Ask ${applicationName}" = "Pergunte ao ${applicationName}";
"Ask ${applicationName} Assist" = "Pergunte ao ${applicationName} Assist";
"Talk to ${applicationName}" = "Fale com o ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Quais ${filter} estão ligadas no ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Que ${filter} estão ligadas no ${applicationName}";
"What is on in ${applicationName}" = "O que está ligado no ${applicationName}";
"What is still on in ${applicationName}" = "O que ainda está ligado no ${applicationName}";
