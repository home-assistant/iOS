/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Activeer ${scene} in ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Activeer de scène ${scene} in ${applicationName}";
"Activate a scene in ${applicationName}" = "Activeer een scène in ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Zet ${entity} aan in ${applicationName}";
"Open ${entity} in ${applicationName}" = "Open ${entity} in ${applicationName}";
"Turn something on in ${applicationName}" = "Zet iets aan in ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Zet ${entity} uit in ${applicationName}";
"Close ${entity} in ${applicationName}" = "Sluit ${entity} in ${applicationName}";
"Turn something off in ${applicationName}" = "Zet iets uit in ${applicationName}";
"Check an entity in ${applicationName}" = "Controleer een entiteit in ${applicationName}";
"Get an entity state from ${applicationName}" = "Haal een entiteitsstatus op uit ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Staat ${entity} aan in ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Wat is de status van ${entity} in ${applicationName}";
"Ask ${applicationName}" = "Vraag ${applicationName}";
"Ask ${applicationName} Assist" = "Vraag ${applicationName} Assist";
"Talk to ${applicationName}" = "Praat met ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Welke ${filter} staan aan in ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Welke ${filter} zijn aan in ${applicationName}";
"What is on in ${applicationName}" = "Wat staat aan in ${applicationName}";
"What is still on in ${applicationName}" = "Wat staat er nog aan in ${applicationName}";
