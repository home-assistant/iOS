"settings.server_select.title" = "Server";
"settings.server_switching.by_location.footer" = "Wanneer je de app opent, controleert deze of je je in een van je woningen bevindt, hetzij verbonden met het wifi-netwerk van die woning, hetzij binnen de thuiszone ervan. Als die woning bij een andere server hoort, wordt die server automatisch geopend. Deze controles vinden alleen plaats op dit apparaat terwijl de app in gebruik is, en je locatie wordt nooit opgeslagen.";
"settings.server_switching.by_location.title" = "Van server wisselen op basis van locatie";
"settings.server_switching.closest_server.title" = "Dichtstbijzijnde server";
"settings.server_switching.how_it_works.intro" = "Als je meerdere woningen hebt, kan de app bepalen welke server op dat moment van belang is en daar automatisch naar overschakelen. Zodra je je tweede woning binnenkomt, staat het dashboard al voor je klaar.";
"settings.server_switching.how_it_works.location.body" = "Anders wordt je locatie vergeleken met de thuiszone van elke server, en wordt de dichtstbijzijnde als meest nabij beschouwd.";
"settings.server_switching.how_it_works.location.title" = "Vervolgens je locatie";
"settings.server_switching.how_it_works.privacy.body" = "Netwerk- en locatiecontroles vinden uitsluitend op dit apparaat plaats, en alleen terwijl de app in gebruik is. Je locatie wordt nooit opgeslagen of gedeeld.";
"settings.server_switching.how_it_works.privacy.title" = "Jouw privacy";
