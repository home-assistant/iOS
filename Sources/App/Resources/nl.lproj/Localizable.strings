"live_activity.privacy.message" = "Live activiteit-inhoud is zichtbaar op je vergrendelscherm en Dynamic Island zonder Face ID of Touch ID. Bedenk goed wat je wilt laten zien.";
"live_activity.sample.alarm.note" = "Aftellen van 60 seconden, zonder voortgangsbalk. Rood geeft urgentie aan, je ziet de timer in realtime aftellen.";
