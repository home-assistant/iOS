"live_activity.sample.all_fields.note" = "Alle velden die de status van de inhoud weergeven, zijn tegelijkertijd actief: pictogram, live aftelling en voortgangsbalk. Bevestigt dat er geen conflicten in de lay-out zijn.";
"live_activity.sample.all_fields.summary" = "Een icoon, een timer en een voortgangsbalk in één.";
"live_activity.sample.all_fields.title" = "Alle velden · De volle mep";
"live_activity.sample.count_down.note" = "chronometer with when: 2700 and when_relative: true — a 45-minute countdown. The tinted timer bar (progress_bar_color) drains as time runs out.";
"live_activity.sample.count_down.summary" = "Een timer van 45 minuten die aftelt, net als een kookwekker.";
"live_activity.sample.count_down.title" = "Oventimer · Aftellen van 45 minuten";
"live_activity.sample.count_up.note" = "chronometer with when: 0 and when_relative: true resolves to \"now\", so the timer counts up — showing elapsed time since the activity started. No progress bar: an unbounded count-up has no end. To count up toward a target, use a negative when instead.";
"live_activity.sample.count_up.summary" = "Een timer die vanaf nul begint met tellen.";
"live_activity.sample.count_up.title" = "Wasmachine · Oplopende timer";
"live_activity.sample.count_up_target.note" = "A negative relative when (when: -1200) counts up toward the target: 0:00 → 20:00, the bar fills, and the timer freezes when it gets there.";
"live_activity.sample.count_up_target.summary" = "Een timer die oploopt naar tot 20 minuten.";
"live_activity.sample.count_up_target.title" = "Training · Oplopend tot 20 minuten";
"live_activity.sample.custom_colors.note" = "Sets a custom background and text color for the Lock Screen card. The Dynamic Island keeps its system-provided dark style.";
"live_activity.sample.custom_colors.summary" = "Een kaart met je eigen achtergrond- en tekstkleuren.";
"live_activity.sample.custom_colors.title" = "Aangepaste kleuren · Achtergrond + tekst";
"live_activity.sample.delivery.note" = "message, criticalText en icon veranderen allemaal bij elke update, er is geen voortgangsbalk. De statuscategorie zelf verandert, niet alleen een waarde.";
"live_activity.sample.delivery.summary" = "Een pakket waarbij de status van ‘verzonden’ naar ‘afgeleverd’ verandert.";
"live_activity.sample.delivery.title" = "Pakketbezorging · Alle tekstvelden";
"live_activity.sample.dishwasher.note" = "Het enige voorbeeld waarbij de test verloopt volgens start → update → einde. Nadat de test is beëindigd, blijft de eindstatus 'Done' nog een tijdje op het vergrendelingsscherm staan (maximaal 4 uur).";
"live_activity.sample.dishwasher.summary" = "Een volledige cyclus die vanzelf begint, loopt en eindigt.";
"live_activity.sample.dishwasher.title" = "Vaatwasser · Volledige cyclus, schakelt zichzelf uit";
"live_activity.sample.ev.note" = "Het numerieke percentage in 'criticalText' wordt gelijktijdig met de voortgangsbalk bijgewerkt. De kleur verandert van groen naar geelgroen naarmate de batterij voller wordt.";
"live_activity.sample.ev.summary" = "Een accu van een auto die volledig wordt opgeladen.";
"live_activity.sample.ev.title" = "Opladen van elektrische auto's · Numeriek %";
"live_activity.sample.media.note" = "De voortgang (afspeelpositie) en een live aftelling (resterende tijd van het nummer) worden gelijktijdig bijgewerkt. Bij het wisselen van nummer worden beide weer op nul gezet.";
"live_activity.sample.media.summary" = "Een nummer dat wordt afgespeeld, met vermelding van de positie en de resterende afspeeltijd.";
"live_activity.sample.media.title" = "Mediaplayer · Voortgang + timer";
"live_activity.sample.no_icon.note" = "Geen icoon en geen kleur, dus de voortgangsbalk krijgt de standaard HA-blauwe tint. 'criticalText' wordt alleen weergegeven in de compacte variant van het Dynamic Island.";
"live_activity.sample.no_icon.summary" = "Een voortgangsbalk in de standaardkleur, zonder icoon.";
"live_activity.sample.no_icon.title" = "Geen icoon · Standaardkleur";
"live_activity.sample.plain.note" = "Minimale lay-out, alleen het berichtveld is ingesteld. Controleert of de kale lay-out wordt weergegeven zonder pictogram, voortgangsbalk of timer.";
"live_activity.sample.plain.summary" = "Een simpel bericht, niks bijzonders.";
"live_activity.sample.plain.title" = "Simpel bericht";
"live_activity.sample.progress_direction.note" = "‘progress_bar_direction: decreasing’ keert de vulling van de balk om: deze geeft dan weer wat er nog over is (progress_max − progress) en loopt leeg naarmate de voortgang toeneemt. De procentuele tekst geeft nog steeds de ruwe voortgangswaarde weer. Dit werkt ook bij timer-balken; bij ‘increasing’ wordt een aftelling bijvoorbeeld gevuld in plaats van leeggelopen.";
"live_activity.sample.progress_direction.summary" = "Een voortgangsbalk die leegloopt in plaats van volloopt.";
"live_activity.sample.progress_direction.title" = "Batterij · Afnemende balk";
"live_activity.sample.rate_limit.note" = "Zes updates met een tussenpoos van 2 seconden. Op iOS 18 geeft het systeem er ongeveer één per 15 seconden weer, sommige worden stilletjes overgeslagen en de teller slaat dan een stap over. Op de simulator en op iOS 17 worden alle zes de updates wel weergegeven.";
"live_activity.sample.rate_limit.summary" = "Snelle, opeenvolgende updates om te testen hoeveel er kunnen worden weergegeven.";
"live_activity.sample.rate_limit.title" = "Snelheidslimiet · 6 snelle updates";
"live_activity.sample.security.note" = "Geen voortgangsbalk, de status wordt volledig weergegeven via kleur en pictogram. De kleur verandert van oranje (beweging) → rood (persoon) → groen (alles in rust).";
