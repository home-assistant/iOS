/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "הפעל את ${scene} ב-${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "הפעל את הסצנה ${scene} ב-${applicationName}";
"Activate a scene in ${applicationName}" = "הפעל סצנה ב-${applicationName}";
"Turn on ${entity} in ${applicationName}" = "הדלק את ${entity} ב-${applicationName}";
"Open ${entity} in ${applicationName}" = "פתח את ${entity} ב-${applicationName}";
"Turn something on in ${applicationName}" = "הדלק משהו ב-${applicationName}";
"Turn off ${entity} in ${applicationName}" = "כבה את ${entity} ב-${applicationName}";
"Close ${entity} in ${applicationName}" = "סגור את ${entity} ב-${applicationName}";
"Turn something off in ${applicationName}" = "כבה משהו ב-${applicationName}";
"Check an entity in ${applicationName}" = "בדוק ישות ב-${applicationName}";
"Get an entity state from ${applicationName}" = "קבל מצב ישות מ-${applicationName}";
"Is ${entity} on in ${applicationName}" = "האם ${entity} דולק ב-${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "מה המצב של ${entity} ב-${applicationName}";
"Ask ${applicationName}" = "שאל את ${applicationName}";
"Ask ${applicationName} Assist" = "שאל את ${applicationName} Assist";
"Talk to ${applicationName}" = "דבר עם ${applicationName}";
"What ${filter} are on in ${applicationName}" = "אילו ${filter} דולקים ב-${applicationName}";
"Which ${filter} are on in ${applicationName}" = "מה מתוך ${filter} דולק ב-${applicationName}";
"What is on in ${applicationName}" = "מה דולק ב-${applicationName}";
"What is still on in ${applicationName}" = "מה עדיין דולק ב-${applicationName}";
