/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Aktivuj ${scene} v ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Aktivuj scénu ${scene} v ${applicationName}";
"Activate a scene in ${applicationName}" = "Aktivuj scénu v ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Zapni ${entity} v ${applicationName}";
"Open ${entity} in ${applicationName}" = "Otevři ${entity} v ${applicationName}";
"Turn something on in ${applicationName}" = "Zapni něco v ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Vypni ${entity} v ${applicationName}";
"Close ${entity} in ${applicationName}" = "Zavři ${entity} v ${applicationName}";
"Turn something off in ${applicationName}" = "Vypni něco v ${applicationName}";
"Check an entity in ${applicationName}" = "Zkontroluj entitu v ${applicationName}";
"Get an entity state from ${applicationName}" = "Získej stav entity z ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Je ${entity} zapnuté v ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Jaký je stav ${entity} v ${applicationName}";
"Ask ${applicationName}" = "Zeptej se ${applicationName}";
"Ask ${applicationName} Assist" = "Zeptej se ${applicationName} Assist";
"Talk to ${applicationName}" = "Mluv s ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Jaké ${filter} jsou zapnuté v ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Které ${filter} jsou zapnuté v ${applicationName}";
"What is on in ${applicationName}" = "Co je zapnuté v ${applicationName}";
"What is still on in ${applicationName}" = "Co je stále zapnuté v ${applicationName}";
