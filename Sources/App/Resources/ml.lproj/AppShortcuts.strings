/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "${applicationName}-ൽ ${scene} സജീവമാക്കുക";
"Activate the ${scene} scene in ${applicationName}" = "${applicationName}-ൽ ${scene} സീൻ സജീവമാക്കുക";
"Activate a scene in ${applicationName}" = "${applicationName}-ൽ ഒരു സീൻ സജീവമാക്കുക";
"Turn on ${entity} in ${applicationName}" = "${applicationName}-ൽ ${entity} ഓണാക്കുക";
"Open ${entity} in ${applicationName}" = "${applicationName}-ൽ ${entity} തുറക്കുക";
"Turn something on in ${applicationName}" = "${applicationName}-ൽ എന്തെങ്കിലും ഓണാക്കുക";
"Turn off ${entity} in ${applicationName}" = "${applicationName}-ൽ ${entity} ഓഫാക്കുക";
"Close ${entity} in ${applicationName}" = "${applicationName}-ൽ ${entity} അടയ്ക്കുക";
"Turn something off in ${applicationName}" = "${applicationName}-ൽ എന്തെങ്കിലും ഓഫാക്കുക";
"Check an entity in ${applicationName}" = "${applicationName}-ൽ ഒരു എന്റിറ്റി പരിശോധിക്കുക";
"Get an entity state from ${applicationName}" = "${applicationName}-ൽ നിന്ന് എന്റിറ്റിയുടെ നില നേടുക";
"Is ${entity} on in ${applicationName}" = "${applicationName}-ൽ ${entity} ഓണാണോ";
"What is the state of ${entity} in ${applicationName}" = "${applicationName}-ൽ ${entity} യുടെ നില എന്താണ്";
"Ask ${applicationName}" = "${applicationName} നോട് ചോദിക്കുക";
"Ask ${applicationName} Assist" = "${applicationName} Assist നോട് ചോദിക്കുക";
"Talk to ${applicationName}" = "${applicationName} മായി സംസാരിക്കുക";
"What ${filter} are on in ${applicationName}" = "${applicationName}-ൽ ഏതൊക്കെ ${filter} ഓണാണ്";
"Which ${filter} are on in ${applicationName}" = "${applicationName}-ൽ ഏത് ${filter} ഓണാണ്";
"What is on in ${applicationName}" = "${applicationName}-ൽ എന്താണ് ഓണായിരിക്കുന്നത്";
"What is still on in ${applicationName}" = "${applicationName}-ൽ ഇപ്പോഴും എന്താണ് ഓണായിരിക്കുന്നത്";
