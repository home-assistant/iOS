/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Kích hoạt ${scene} trong ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Kích hoạt cảnh ${scene} trong ${applicationName}";
"Activate a scene in ${applicationName}" = "Kích hoạt một cảnh trong ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Bật ${entity} trong ${applicationName}";
"Open ${entity} in ${applicationName}" = "Mở ${entity} trong ${applicationName}";
"Turn something on in ${applicationName}" = "Bật thứ gì đó trong ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Tắt ${entity} trong ${applicationName}";
"Close ${entity} in ${applicationName}" = "Đóng ${entity} trong ${applicationName}";
"Turn something off in ${applicationName}" = "Tắt thứ gì đó trong ${applicationName}";
"Check an entity in ${applicationName}" = "Kiểm tra một thực thể trong ${applicationName}";
"Get an entity state from ${applicationName}" = "Lấy trạng thái thực thể từ ${applicationName}";
"Is ${entity} on in ${applicationName}" = "${entity} có đang bật trong ${applicationName} không";
"What is the state of ${entity} in ${applicationName}" = "Trạng thái của ${entity} trong ${applicationName} là gì";
"Ask ${applicationName}" = "Hỏi ${applicationName}";
"Ask ${applicationName} Assist" = "Hỏi ${applicationName} Assist";
"Talk to ${applicationName}" = "Nói chuyện với ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Những ${filter} nào đang bật trong ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "${filter} nào đang bật trong ${applicationName}";
"What is on in ${applicationName}" = "Cái gì đang bật trong ${applicationName}";
"What is still on in ${applicationName}" = "Cái gì vẫn đang bật trong ${applicationName}";
