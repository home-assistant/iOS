/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Activa ${scene} a ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Activa l'escena ${scene} a ${applicationName}";
"Activate a scene in ${applicationName}" = "Activa una escena a ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Encén ${entity} a ${applicationName}";
"Open ${entity} in ${applicationName}" = "Obre ${entity} a ${applicationName}";
"Turn something on in ${applicationName}" = "Encén alguna cosa a ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Apaga ${entity} a ${applicationName}";
"Close ${entity} in ${applicationName}" = "Tanca ${entity} a ${applicationName}";
"Turn something off in ${applicationName}" = "Apaga alguna cosa a ${applicationName}";
"Check an entity in ${applicationName}" = "Comprova una entitat a ${applicationName}";
"Get an entity state from ${applicationName}" = "Obtén l'estat d'una entitat de ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Està encès ${entity} a ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Quin és l'estat de ${entity} a ${applicationName}";
"Ask ${applicationName}" = "Pregunta a ${applicationName}";
"Ask ${applicationName} Assist" = "Pregunta a ${applicationName} Assist";
"Talk to ${applicationName}" = "Parla amb ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Quins ${filter} estan encesos a ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Quins ${filter} hi ha encesos a ${applicationName}";
"What is on in ${applicationName}" = "Què hi ha encès a ${applicationName}";
"What is still on in ${applicationName}" = "Què continua encès a ${applicationName}";
