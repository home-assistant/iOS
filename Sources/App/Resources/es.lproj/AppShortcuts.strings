/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Activa ${scene} en ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Activa la escena ${scene} en ${applicationName}";
"Activate a scene in ${applicationName}" = "Activa una escena en ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Enciende ${entity} en ${applicationName}";
"Open ${entity} in ${applicationName}" = "Abre ${entity} en ${applicationName}";
"Turn something on in ${applicationName}" = "Enciende algo en ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Apaga ${entity} en ${applicationName}";
"Close ${entity} in ${applicationName}" = "Cierra ${entity} en ${applicationName}";
"Turn something off in ${applicationName}" = "Apaga algo en ${applicationName}";
"Check an entity in ${applicationName}" = "Comprueba una entidad en ${applicationName}";
"Get an entity state from ${applicationName}" = "Obtén el estado de una entidad de ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Está ${entity} encendido en ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Cuál es el estado de ${entity} en ${applicationName}";
"Ask ${applicationName}" = "Pregunta a ${applicationName}";
"Ask ${applicationName} Assist" = "Pregunta a ${applicationName} Assist";
"Talk to ${applicationName}" = "Habla con ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Qué ${filter} están encendidas en ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Cuáles ${filter} están encendidas en ${applicationName}";
"What is on in ${applicationName}" = "Qué está encendido en ${applicationName}";
"What is still on in ${applicationName}" = "Qué sigue encendido en ${applicationName}";
