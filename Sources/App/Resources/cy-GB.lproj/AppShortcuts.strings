/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Actifadu ${scene} yn ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Actifadu golygfa ${scene} yn ${applicationName}";
"Activate a scene in ${applicationName}" = "Actifadu golygfa yn ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Troi ${entity} ymlaen yn ${applicationName}";
"Open ${entity} in ${applicationName}" = "Agor ${entity} yn ${applicationName}";
"Turn something on in ${applicationName}" = "Troi rhywbeth ymlaen yn ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Diffodd ${entity} yn ${applicationName}";
"Close ${entity} in ${applicationName}" = "Cau ${entity} yn ${applicationName}";
"Turn something off in ${applicationName}" = "Diffodd rhywbeth yn ${applicationName}";
"Check an entity in ${applicationName}" = "Gwirio endid yn ${applicationName}";
"Get an entity state from ${applicationName}" = "Cael cyflwr endid o ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Ydy ${entity} ymlaen yn ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Beth yw cyflwr ${entity} yn ${applicationName}";
"Ask ${applicationName}" = "Gofyn i ${applicationName}";
"Ask ${applicationName} Assist" = "Gofyn i ${applicationName} Assist";
"Talk to ${applicationName}" = "Siarad â ${applicationName}";
