/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Aktifkan ${scene} di ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Aktifkan skena ${scene} di ${applicationName}";
"Activate a scene in ${applicationName}" = "Aktifkan skena di ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Nyalakan ${entity} di ${applicationName}";
"Open ${entity} in ${applicationName}" = "Buka ${entity} di ${applicationName}";
"Turn something on in ${applicationName}" = "Nyalakan sesuatu di ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Matikan ${entity} di ${applicationName}";
"Close ${entity} in ${applicationName}" = "Tutup ${entity} di ${applicationName}";
"Turn something off in ${applicationName}" = "Matikan sesuatu di ${applicationName}";
"Check an entity in ${applicationName}" = "Periksa entitas di ${applicationName}";
"Get an entity state from ${applicationName}" = "Dapatkan status entitas dari ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Apakah ${entity} menyala di ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Apa status ${entity} di ${applicationName}";
"Ask ${applicationName}" = "Tanya ${applicationName}";
"Ask ${applicationName} Assist" = "Tanya ${applicationName} Assist";
"Talk to ${applicationName}" = "Bicara dengan ${applicationName}";
"What ${filter} are on in ${applicationName}" = "${filter} apa saja yang menyala di ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "${filter} mana yang menyala di ${applicationName}";
"What is on in ${applicationName}" = "Apa yang menyala di ${applicationName}";
"What is still on in ${applicationName}" = "Apa yang masih menyala di ${applicationName}";
