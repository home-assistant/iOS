/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Активирай ${scene} в ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Активирай сцената ${scene} в ${applicationName}";
"Activate a scene in ${applicationName}" = "Активирай сцена в ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Включи ${entity} в ${applicationName}";
"Open ${entity} in ${applicationName}" = "Отвори ${entity} в ${applicationName}";
"Turn something on in ${applicationName}" = "Включи нещо в ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Изключи ${entity} в ${applicationName}";
"Close ${entity} in ${applicationName}" = "Затвори ${entity} в ${applicationName}";
"Turn something off in ${applicationName}" = "Изключи нещо в ${applicationName}";
"Check an entity in ${applicationName}" = "Провери обект в ${applicationName}";
"Get an entity state from ${applicationName}" = "Вземи състоянието на обект от ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Включен ли е ${entity} в ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Какво е състоянието на ${entity} в ${applicationName}";
"Ask ${applicationName}" = "Попитай ${applicationName}";
"Ask ${applicationName} Assist" = "Попитай ${applicationName} Assist";
"Talk to ${applicationName}" = "Говори с ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Кои ${filter} са включени в ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Какви ${filter} са включени в ${applicationName}";
"What is on in ${applicationName}" = "Какво е включено в ${applicationName}";
"What is still on in ${applicationName}" = "Какво все още е включено в ${applicationName}";
