/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "${applicationName}で${scene}を実行";
"Activate the ${scene} scene in ${applicationName}" = "${applicationName}で${scene}シーンを実行";
"Activate a scene in ${applicationName}" = "${applicationName}でシーンを実行";
"Turn on ${entity} in ${applicationName}" = "${applicationName}で${entity}をつけて";
"Open ${entity} in ${applicationName}" = "${applicationName}で${entity}を開けて";
"Turn something on in ${applicationName}" = "${applicationName}で何かをつけて";
"Turn off ${entity} in ${applicationName}" = "${applicationName}で${entity}を消して";
"Close ${entity} in ${applicationName}" = "${applicationName}で${entity}を閉めて";
"Turn something off in ${applicationName}" = "${applicationName}で何かを消して";
"Check an entity in ${applicationName}" = "${applicationName}でエンティティを確認";
"Get an entity state from ${applicationName}" = "${applicationName}からエンティティの状態を取得";
"Is ${entity} on in ${applicationName}" = "${applicationName}で${entity}はついている";
"What is the state of ${entity} in ${applicationName}" = "${applicationName}で${entity}の状態は";
"Ask ${applicationName}" = "${applicationName}に聞いて";
"Ask ${applicationName} Assist" = "${applicationName} Assistに聞いて";
"Talk to ${applicationName}" = "${applicationName}と話す";
"What ${filter} are on in ${applicationName}" = "${applicationName}でどの${filter}がついている";
"Which ${filter} are on in ${applicationName}" = "${applicationName}でついている${filter}は";
"What is on in ${applicationName}" = "${applicationName}で何がついている";
"What is still on in ${applicationName}" = "${applicationName}でまだ何がついている";
