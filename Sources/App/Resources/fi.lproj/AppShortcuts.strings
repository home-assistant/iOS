/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Aktivoi ${scene} sovelluksessa ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Aktivoi kohtaus ${scene} sovelluksessa ${applicationName}";
"Activate a scene in ${applicationName}" = "Aktivoi kohtaus sovelluksessa ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Laita ${entity} päälle sovelluksessa ${applicationName}";
"Open ${entity} in ${applicationName}" = "Avaa ${entity} sovelluksessa ${applicationName}";
"Turn something on in ${applicationName}" = "Laita jotain päälle sovelluksessa ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Sammuta ${entity} sovelluksessa ${applicationName}";
"Close ${entity} in ${applicationName}" = "Sulje ${entity} sovelluksessa ${applicationName}";
"Turn something off in ${applicationName}" = "Sammuta jotain sovelluksessa ${applicationName}";
"Check an entity in ${applicationName}" = "Tarkista entiteetti sovelluksessa ${applicationName}";
"Get an entity state from ${applicationName}" = "Hae entiteetin tila sovelluksesta ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Onko ${entity} päällä sovelluksessa ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Mikä on kohteen ${entity} tila sovelluksessa ${applicationName}";
"Ask ${applicationName}" = "Kysy sovellukselta ${applicationName}";
"Ask ${applicationName} Assist" = "Kysy ${applicationName} Assistilta";
"Talk to ${applicationName}" = "Puhu sovellukselle ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Mitkä ${filter} ovat päällä sovelluksessa ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Mitkä ${filter} ovat käynnissä sovelluksessa ${applicationName}";
"What is on in ${applicationName}" = "Mikä on päällä sovelluksessa ${applicationName}";
"What is still on in ${applicationName}" = "Mikä on vielä päällä sovelluksessa ${applicationName}";
