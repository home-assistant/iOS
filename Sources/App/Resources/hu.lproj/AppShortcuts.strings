/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Activate ${scene} in ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Activate the ${scene} scene in ${applicationName}";
"Activate a scene in ${applicationName}" = "Activate a scene in ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Turn on ${entity} in ${applicationName}";
"Open ${entity} in ${applicationName}" = "Open ${entity} in ${applicationName}";
"Turn something on in ${applicationName}" = "Turn something on in ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Turn off ${entity} in ${applicationName}";
"Close ${entity} in ${applicationName}" = "Close ${entity} in ${applicationName}";
"Turn something off in ${applicationName}" = "Turn something off in ${applicationName}";
"Check an entity in ${applicationName}" = "Check an entity in ${applicationName}";
"Get an entity state from ${applicationName}" = "Get an entity state from ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Is ${entity} on in ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "What is the state of ${entity} in ${applicationName}";
"Ask ${applicationName}" = "Ask ${applicationName}";
"Ask ${applicationName} Assist" = "Ask ${applicationName} Assist";
"Talk to ${applicationName}" = "Talk to ${applicationName}";
"What ${filter} are on in ${applicationName}" = "What ${filter} are on in ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Which ${filter} are on in ${applicationName}";
"What is on in ${applicationName}" = "What is on in ${applicationName}";
"What is still on in ${applicationName}" = "What is still on in ${applicationName}";
