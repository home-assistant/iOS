/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Aktiváld a ${scene} jelenetet a ${applicationName} appban";
"Activate the ${scene} scene in ${applicationName}" = "Aktiváld a ${scene} jelenetet a ${applicationName} alkalmazásban";
"Activate a scene in ${applicationName}" = "Aktiválj egy jelenetet a ${applicationName} appban";
"Turn on ${entity} in ${applicationName}" = "Kapcsold be a ${entity} eszközt a ${applicationName} appban";
"Open ${entity} in ${applicationName}" = "Nyisd ki a ${entity} eszközt a ${applicationName} appban";
"Turn something on in ${applicationName}" = "Kapcsolj be valamit a ${applicationName} appban";
"Turn off ${entity} in ${applicationName}" = "Kapcsold ki a ${entity} eszközt a ${applicationName} appban";
"Close ${entity} in ${applicationName}" = "Zárd be a ${entity} eszközt a ${applicationName} appban";
"Turn something off in ${applicationName}" = "Kapcsolj ki valamit a ${applicationName} appban";
"Check an entity in ${applicationName}" = "Ellenőrizz egy entitást a ${applicationName} appban";
"Get an entity state from ${applicationName}" = "Kérdezd le egy entitás állapotát a ${applicationName} appból";
"Is ${entity} on in ${applicationName}" = "Be van kapcsolva a ${entity} a ${applicationName} appban";
"What is the state of ${entity} in ${applicationName}" = "Mi a ${entity} állapota a ${applicationName} appban";
"Ask ${applicationName}" = "Kérdezd meg a ${applicationName} appot";
"Ask ${applicationName} Assist" = "Kérdezd meg a ${applicationName} Assistet";
"Talk to ${applicationName}" = "Beszélj a ${applicationName} apppal";
"What ${filter} are on in ${applicationName}" = "Mely ${filter} vannak bekapcsolva a ${applicationName} appban";
"Which ${filter} are on in ${applicationName}" = "Melyik ${filter} van bekapcsolva a ${applicationName} appban";
"What is on in ${applicationName}" = "Mi van bekapcsolva a ${applicationName} appban";
"What is still on in ${applicationName}" = "Mi van még bekapcsolva a ${applicationName} appban";
