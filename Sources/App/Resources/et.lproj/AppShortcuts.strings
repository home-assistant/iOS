/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Aktiveeri ${scene} rakenduses ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Aktiveeri stseen ${scene} rakenduses ${applicationName}";
"Activate a scene in ${applicationName}" = "Aktiveeri stseen rakenduses ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Lülita ${entity} sisse rakenduses ${applicationName}";
"Open ${entity} in ${applicationName}" = "Ava ${entity} rakenduses ${applicationName}";
"Turn something on in ${applicationName}" = "Lülita midagi sisse rakenduses ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Lülita ${entity} välja rakenduses ${applicationName}";
"Close ${entity} in ${applicationName}" = "Sulge ${entity} rakenduses ${applicationName}";
"Turn something off in ${applicationName}" = "Lülita midagi välja rakenduses ${applicationName}";
"Check an entity in ${applicationName}" = "Kontrolli olemit rakenduses ${applicationName}";
"Get an entity state from ${applicationName}" = "Hangi olemi olek rakendusest ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Kas ${entity} on sees rakenduses ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Mis on ${entity} olek rakenduses ${applicationName}";
"Ask ${applicationName}" = "Küsi rakenduselt ${applicationName}";
"Ask ${applicationName} Assist" = "Küsi ${applicationName} Assistilt";
"Talk to ${applicationName}" = "Räägi rakendusega ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Millised ${filter} on sees rakenduses ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Mis ${filter} on sees rakenduses ${applicationName}";
"What is on in ${applicationName}" = "Mis on sees rakenduses ${applicationName}";
"What is still on in ${applicationName}" = "Mis on veel sees rakenduses ${applicationName}";
