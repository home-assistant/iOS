/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "${applicationName} uygulamasında ${scene} etkinleştir";
"Activate the ${scene} scene in ${applicationName}" = "${applicationName} uygulamasında ${scene} sahnesini etkinleştir";
"Activate a scene in ${applicationName}" = "${applicationName} uygulamasında bir sahne etkinleştir";
"Turn on ${entity} in ${applicationName}" = "${applicationName} uygulamasında ${entity} aç";
"Open ${entity} in ${applicationName}" = "${applicationName} uygulamasında ${entity} açık konuma getir";
"Turn something on in ${applicationName}" = "${applicationName} uygulamasında bir şeyi aç";
"Turn off ${entity} in ${applicationName}" = "${applicationName} uygulamasında ${entity} kapat";
"Close ${entity} in ${applicationName}" = "${applicationName} uygulamasında ${entity} kapalı konuma getir";
"Turn something off in ${applicationName}" = "${applicationName} uygulamasında bir şeyi kapat";
"Check an entity in ${applicationName}" = "${applicationName} uygulamasında bir varlığı kontrol et";
"Get an entity state from ${applicationName}" = "${applicationName} uygulamasından varlık durumunu al";
"Is ${entity} on in ${applicationName}" = "${applicationName} uygulamasında ${entity} açık mı";
"What is the state of ${entity} in ${applicationName}" = "${applicationName} uygulamasında ${entity} durumu nedir";
"Ask ${applicationName}" = "${applicationName} uygulamasına sor";
"Ask ${applicationName} Assist" = "${applicationName} Assist'e sor";
"Talk to ${applicationName}" = "${applicationName} ile konuş";
"What ${filter} are on in ${applicationName}" = "${applicationName} uygulamasında hangi ${filter} açık";
"Which ${filter} are on in ${applicationName}" = "${applicationName} uygulamasında ${filter} hangileri açık";
"What is on in ${applicationName}" = "${applicationName} uygulamasında neler açık";
"What is still on in ${applicationName}" = "${applicationName} uygulamasında hâlâ neler açık";
