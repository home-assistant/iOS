/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "在${applicationName}中激活${scene}";
"Activate the ${scene} scene in ${applicationName}" = "在${applicationName}中激活${scene}场景";
"Activate a scene in ${applicationName}" = "在${applicationName}中激活场景";
"Turn on ${entity} in ${applicationName}" = "在${applicationName}中打开${entity}";
"Open ${entity} in ${applicationName}" = "在${applicationName}中开启${entity}";
"Turn something on in ${applicationName}" = "在${applicationName}中打开某个设备";
"Turn off ${entity} in ${applicationName}" = "在${applicationName}中关闭${entity}";
"Close ${entity} in ${applicationName}" = "在${applicationName}中关上${entity}";
"Turn something off in ${applicationName}" = "在${applicationName}中关闭某个设备";
"Check an entity in ${applicationName}" = "在${applicationName}中查看实体";
"Get an entity state from ${applicationName}" = "从${applicationName}获取实体状态";
"Is ${entity} on in ${applicationName}" = "${applicationName}中的${entity}开着吗";
"What is the state of ${entity} in ${applicationName}" = "${applicationName}中${entity}的状态是什么";
"Ask ${applicationName}" = "问${applicationName}";
"Ask ${applicationName} Assist" = "问${applicationName} Assist";
"Talk to ${applicationName}" = "和${applicationName}对话";
"What ${filter} are on in ${applicationName}" = "${applicationName}中哪些${filter}开着";
"Which ${filter} are on in ${applicationName}" = "${applicationName}中有哪些${filter}开着";
"What is on in ${applicationName}" = "${applicationName}中有什么开着";
"What is still on in ${applicationName}" = "${applicationName}中还有什么开着";
