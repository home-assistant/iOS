/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Aktivér ${scene} i ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Aktivér scenen ${scene} i ${applicationName}";
"Activate a scene in ${applicationName}" = "Aktivér en scene i ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Tænd ${entity} i ${applicationName}";
"Open ${entity} in ${applicationName}" = "Åbn ${entity} i ${applicationName}";
"Turn something on in ${applicationName}" = "Tænd noget i ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Sluk ${entity} i ${applicationName}";
"Close ${entity} in ${applicationName}" = "Luk ${entity} i ${applicationName}";
"Turn something off in ${applicationName}" = "Sluk noget i ${applicationName}";
"Check an entity in ${applicationName}" = "Tjek en enhed i ${applicationName}";
"Get an entity state from ${applicationName}" = "Hent en enhedsstatus fra ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Er ${entity} tændt i ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Hvad er status for ${entity} i ${applicationName}";
"Ask ${applicationName}" = "Spørg ${applicationName}";
"Ask ${applicationName} Assist" = "Spørg ${applicationName} Assist";
"Talk to ${applicationName}" = "Tal med ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Hvilke ${filter} er tændt i ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Hvilke ${filter} er aktive i ${applicationName}";
"What is on in ${applicationName}" = "Hvad er tændt i ${applicationName}";
"What is still on in ${applicationName}" = "Hvad er stadig tændt i ${applicationName}";
