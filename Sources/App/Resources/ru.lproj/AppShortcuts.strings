/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Активируй ${scene} в ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Активируй сцену ${scene} в ${applicationName}";
"Activate a scene in ${applicationName}" = "Активируй сцену в ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Включи ${entity} в ${applicationName}";
"Open ${entity} in ${applicationName}" = "Открой ${entity} в ${applicationName}";
"Turn something on in ${applicationName}" = "Включи что-нибудь в ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Выключи ${entity} в ${applicationName}";
"Close ${entity} in ${applicationName}" = "Закрой ${entity} в ${applicationName}";
"Turn something off in ${applicationName}" = "Выключи что-нибудь в ${applicationName}";
"Check an entity in ${applicationName}" = "Проверь объект в ${applicationName}";
"Get an entity state from ${applicationName}" = "Получи состояние объекта из ${applicationName}";
"Is ${entity} on in ${applicationName}" = "${entity} включён в ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Какое состояние у ${entity} в ${applicationName}";
"Ask ${applicationName}" = "Спроси ${applicationName}";
"Ask ${applicationName} Assist" = "Спроси ${applicationName} Assist";
"Talk to ${applicationName}" = "Поговори с ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Какие ${filter} включены в ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Что из ${filter} включено в ${applicationName}";
"What is on in ${applicationName}" = "Что включено в ${applicationName}";
"What is still on in ${applicationName}" = "Что всё ещё включено в ${applicationName}";
