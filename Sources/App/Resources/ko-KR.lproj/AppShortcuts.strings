/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "${applicationName}에서 ${scene} 실행";
"Activate the ${scene} scene in ${applicationName}" = "${applicationName}에서 ${scene} 장면 실행";
"Activate a scene in ${applicationName}" = "${applicationName}에서 장면 실행";
"Turn on ${entity} in ${applicationName}" = "${applicationName}에서 ${entity} 켜기";
"Open ${entity} in ${applicationName}" = "${applicationName}에서 ${entity} 열기";
"Turn something on in ${applicationName}" = "${applicationName}에서 무언가 켜기";
"Turn off ${entity} in ${applicationName}" = "${applicationName}에서 ${entity} 끄기";
"Close ${entity} in ${applicationName}" = "${applicationName}에서 ${entity} 닫기";
"Turn something off in ${applicationName}" = "${applicationName}에서 무언가 끄기";
"Check an entity in ${applicationName}" = "${applicationName}에서 엔티티 확인";
"Get an entity state from ${applicationName}" = "${applicationName}에서 엔티티 상태 가져오기";
"Is ${entity} on in ${applicationName}" = "${applicationName}에서 ${entity} 켜져 있어";
"What is the state of ${entity} in ${applicationName}" = "${applicationName}에서 ${entity} 상태가 뭐야";
"Ask ${applicationName}" = "${applicationName}에게 물어봐";
"Ask ${applicationName} Assist" = "${applicationName} Assist에게 물어봐";
"Talk to ${applicationName}" = "${applicationName}와 대화하기";
"What ${filter} are on in ${applicationName}" = "${applicationName}에서 어떤 ${filter} 켜져 있어";
"Which ${filter} are on in ${applicationName}" = "${applicationName}에서 켜져 있는 ${filter}";
"What is on in ${applicationName}" = "${applicationName}에서 뭐가 켜져 있어";
"What is still on in ${applicationName}" = "${applicationName}에서 아직 뭐가 켜져 있어";
