"live_activity.privacy.message" = "El contenido de la actividad en directo se muestra en la pantalla de bloqueo y en Dynamic Island sin necesidad de Face ID ni Touch ID. Elige con cuidado lo que quieres mostrar.";
"live_activity.sample.alarm.note" = "Una cuenta atrás breve de 60 segundos, sin barra de progreso. El color rojo transmite urgencia: observa cómo el temporizador va contando en tiempo real.";
"live_activity.sample.alarm.summary" = "Una cuenta atrás roja de 60 segundos que llama la atención.";
"live_activity.sample.alarm.title" = "Alarma · Cuenta atrás de 60 segundos";
"live_activity.sample.all_fields.note" = "Todos los campos de estado de contenido están activos a la vez: icono, cuenta atrás en tiempo real y barra de progreso. Se confirma que no hay conflictos de diseño.";
"live_activity.sample.all_fields.summary" = "Un icono, un temporizador y una barra de progreso, todo en uno.";
"live_activity.sample.all_fields.title" = "Todos los campos · Carga máxima";
"live_activity.sample.count_down.note" = "cronómetro con \"when: 2700\" y \"when_relative: true\": una cuenta atrás de 45 minutos. La barra de tiempo de color (progress_bar_color) se va vaciando a medida que se agota el tiempo.";
"live_activity.sample.count_down.summary" = "Una cuenta atrás de 45 minutos, como un temporizador de cocina.";
"live_activity.sample.count_down.title" = "Temporizador de horno · Cuenta atrás de 45 minutos";
"live_activity.sample.count_up.note" = "El cronómetro con \"when: 0\" y \"when_relative: true\" se interpreta como «ahora», por lo que el temporizador cuenta hacia arriba, mostrando el tiempo transcurrido desde que comenzó la actividad. No hay barra de progreso: un recuento hacia arriba sin límite no tiene fin. Para contar hacia arriba hasta un objetivo, utiliza en su lugar un valor negativo en «when».";
"live_activity.sample.count_up.summary" = "Un temporizador que cuenta hacia arriba desde cero.";
"live_activity.sample.count_up.title" = "Lavadora · Temporizador de cuenta ascendente";
"live_activity.sample.count_up_target.note" = "Un valor relativo negativo (cuando: -1200) cuenta hacia adelante hasta el objetivo: 0:00 → 20:00; la barra se va llenando y el temporizador se detiene al llegar allí.";
"live_activity.sample.count_up_target.summary" = "Un temporizador que cuenta hacia adelante hasta alcanzar un objetivo de 20 minutos.";
"live_activity.sample.count_up_target.title" = "Entrenamiento · Contar hasta 20 minutos";
"live_activity.sample.custom_colors.note" = "Establece un color de fondo y de texto personalizados para la tarjeta de la pantalla de bloqueo. La Dynamic Island mantiene el estilo oscuro predeterminado del sistema.";
"live_activity.sample.custom_colors.summary" = "Una tarjeta con los colores de fondo y de texto que tú elijas.";
"live_activity.sample.custom_colors.title" = "Colores personalizados · Fondo + Texto";
"live_activity.sample.delivery.note" = "El mensaje, el texto crítico y el icono cambian en cada actualización; no hay barra de progreso. Es la propia categoría de estado la que cambia, no solo un valor.";
"live_activity.sample.delivery.summary" = "Un paquete que pasa del estado «enviado» al de «entregado».";
"live_activity.sample.delivery.title" = "Entrega de paquetes · Todos los campos de texto";
"live_activity.sample.dishwasher.note" = "La única muestra en la que las pruebas siguen el orden: inicio → actualización → fin. Una vez finalizadas, el estado final \"Hecho\" permanece en la pantalla de bloqueo (hasta 4 h).";
"live_activity.sample.dishwasher.summary" = "Un ciclo completo que comienza, se desarrolla y finaliza por sí solo.";
"live_activity.sample.dishwasher.title" = "Lavavajillas · Ciclo de vida completo, se apaga solo";
"live_activity.sample.ev.note" = "El porcentaje numérico que aparece en «criticalText» se actualiza a medida que avanza la barra de progreso; el color cambia de verde a amarillo verdoso a medida que la carga se acerca al máximo.";
"live_activity.sample.ev.summary" = "Una batería de coche que se está cargando hasta alcanzar su capacidad máxima.";
"live_activity.sample.ev.title" = "Recarga de vehículos eléctricos · Porcentaje numérico";
"live_activity.sample.media.note" = "El progreso (posición de reproducción) y la cuenta atrás en tiempo real (tiempo restante de la pista) se actualizan al mismo tiempo. Al cambiar de pista, ambos se reinician.";
"live_activity.sample.media.summary" = "La canción que se está reproduciendo en este momento, con su posición y el tiempo restante.";
"live_activity.sample.media.title" = "Reproductor multimedia · Progreso + Temporizador";
"live_activity.sample.no_icon.note" = "No hay icono ni color, por lo que la barra de progreso utiliza el tono azul predeterminado de HA. El texto «criticalText» solo se muestra en la parte inferior de la Dynamic Island compacta.";
"live_activity.sample.no_icon.summary" = "Una barra de progreso del color predeterminado, sin icono.";
"live_activity.sample.no_icon.title" = "Sin icono · Color predeterminado";
"live_activity.sample.plain.note" = "Diseño mínimo viable: solo se configura el campo de mensaje. Comprueba que el diseño básico se muestre sin iconos, barra de progreso ni temporizador.";
"live_activity.sample.plain.summary" = "Un mensaje sencillo, sin nada más.";
"live_activity.sample.plain.title" = "Mensaje sin formato";
"live_activity.sample.progress_direction.note" = "progress_bar_direction: si se establece en «decreciente», invierte el relleno de la barra: muestra lo que queda (progress_max − progress) y se va vaciando a medida que avanza el progreso. El texto del porcentaje sigue mostrando el valor de progreso sin procesar. También funciona en barras de temporizador; por ejemplo, si se establece en «creciente», la cuenta atrás se va llenando en lugar de vaciarse.";
"live_activity.sample.progress_direction.summary" = "Una barra de progreso que se vacía en lugar de llenarse.";
"live_activity.sample.progress_direction.title" = "Batería · Barra de nivel decreciente";
"live_activity.sample.rate_limit.note" = "Seis actualizaciones con un intervalo de 2 s entre ellas. En iOS 18, el sistema muestra aproximadamente una cada 15 s; algunas se omiten sin avisar y el contador salta. En el simulador y en iOS 17 se muestran las seis.";
"live_activity.sample.rate_limit.summary" = "Actualizaciones rápidas y consecutivas para comprobar cuántas se muestran.";
"live_activity.sample.rate_limit.title" = "Límite de solicitudes · 6 actualizaciones rápidas";
"live_activity.sample.security.note" = "No hay barra de progreso: el estado se transmite exclusivamente a través del color y el icono. Pasa de naranja (movimiento) → rojo (persona) → verde (todo en orden).";
"live_activity.sample.security.summary" = "Una alerta de seguridad que se intensifica y, a continuación, se da el visto bueno.";
"live_activity.sample.security.title" = "Escalado de seguridad · Color + Icono";
"live_activity.sample.washing.note" = "El progreso avanza a través de cinco etapas con nombre; «criticalText» indica la etapa actual. El icono cambia a una marca de verificación una vez completada la etapa.";
"live_activity.sample.washing.summary" = "Un ciclo de lavado que recorre cada una de sus fases.";
"live_activity.sample.washing.title" = "Lavadora · Etiquetas de etapas";
