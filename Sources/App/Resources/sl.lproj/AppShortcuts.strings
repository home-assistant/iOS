/* Spoken phrases for the App Shortcuts. The key is the English phrase exactly as written in code.
   ${applicationName} is the app name and must stay in every phrase; ${entity}, ${scene} and
   ${filter} are replaced by what the person says. Translate the wording around them. */

"Activate ${scene} in ${applicationName}" = "Aktiviraj ${scene} v ${applicationName}";
"Activate the ${scene} scene in ${applicationName}" = "Aktiviraj sceno ${scene} v ${applicationName}";
"Activate a scene in ${applicationName}" = "Aktiviraj sceno v ${applicationName}";
"Turn on ${entity} in ${applicationName}" = "Vklopi ${entity} v ${applicationName}";
"Open ${entity} in ${applicationName}" = "Odpri ${entity} v ${applicationName}";
"Turn something on in ${applicationName}" = "Vklopi nekaj v ${applicationName}";
"Turn off ${entity} in ${applicationName}" = "Izklopi ${entity} v ${applicationName}";
"Close ${entity} in ${applicationName}" = "Zapri ${entity} v ${applicationName}";
"Turn something off in ${applicationName}" = "Izklopi nekaj v ${applicationName}";
"Check an entity in ${applicationName}" = "Preveri entiteto v ${applicationName}";
"Get an entity state from ${applicationName}" = "Pridobi stanje entitete iz ${applicationName}";
"Is ${entity} on in ${applicationName}" = "Ali je ${entity} vklopljen v ${applicationName}";
"What is the state of ${entity} in ${applicationName}" = "Kakšno je stanje ${entity} v ${applicationName}";
"Ask ${applicationName}" = "Vprašaj ${applicationName}";
"Ask ${applicationName} Assist" = "Vprašaj ${applicationName} Assist";
"Talk to ${applicationName}" = "Pogovori se z ${applicationName}";
"What ${filter} are on in ${applicationName}" = "Kateri ${filter} so vklopljeni v ${applicationName}";
"Which ${filter} are on in ${applicationName}" = "Kaj od ${filter} je vklopljeno v ${applicationName}";
"What is on in ${applicationName}" = "Kaj je vklopljeno v ${applicationName}";
"What is still on in ${applicationName}" = "Kaj je še vedno vklopljeno v ${applicationName}";
